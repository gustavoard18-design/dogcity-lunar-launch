# Modo "qa" (npx vite --mode qa): o jogo fala com um servidor inexistente, que os
# testes de navegador simulam (scripts/qa/dogcoin.mjs). Nunca aponta para o
# Supabase de verdade, então nada vai para o ranking nem para os prêmios reais.
VITE_SUPABASE_URL=https://qa-mock.invalid
VITE_SUPABASE_KEY=qa-mock-key
VITE_SUBMIT_IN_DEV=1
